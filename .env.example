# ==============================================================================
# Tweets — Autonomous X Agent Configuration & Environment Variables
# ==============================================================================

# Razorpay API Credentials
# Get your Key ID and Key Secret from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Exchange Rate (1 USD to INR)
USD_TO_INR_RATE=85.0

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///tweets.db

# API Server Host and Port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# X (Twitter) OAuth 2.0 Credentials (PKCE)
# Create a Project & App at https://developer.twitter.com/en/portal/dashboard
# Set Type of App: "Single-page App" or "Web App"
# Callback URI: http://localhost:8000/api/auth/x/callback
X_CLIENT_ID=your_x_client_id_here
X_CLIENT_SECRET=your_x_client_secret_here
X_REDIRECT_URI=http://localhost:8000/api/auth/x/callback

# Mock Authorization (Set to 1 or true for local dev/testing without live X keys)
# Defaults to auto (activates when X_CLIENT_ID is unset or placeholder)
X_MOCK_AUTH=auto
